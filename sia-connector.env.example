# =============================================================================
# CyberArk SIA Kubernetes Connector — installation parameters
#
#   cp sia-connector.env.example sia-connector.env
#   $EDITOR sia-connector.env
#   chmod 600 sia-connector.env
#   ./sia-connector-install.sh --config ./sia-connector.env --check-only
#
# Every value below can also be passed as a command-line flag; flags win.
# Do NOT put the service-account password in this file — see the note at the end.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — from the SIA Admin Portal
# -----------------------------------------------------------------------------

# The domain of your SIA environment. Used to build the identity and API URLs:
#   https://<IDAPTIVE_TENANT_ID>.id.<ROOT_DOMAIN>
#   https://<TENANT_SUBDOMAIN>.dpa.<ROOT_DOMAIN>/api
# This value is compiled into the container image and cannot be changed
# afterwards without rebuilding.
ROOT_DOMAIN=""

# Your CyberArk Identity tenant ID (Identity Administration → Settings).
IDAPTIVE_TENANT_ID=""

# Your tenant subdomain — the first label of your SIA portal URL.
TENANT_SUBDOMAIN=""

# Connector Pool ID: Connector Pools → <your pool> → the pool's ID.
CONNECTOR_POOL_ID=""

# Service-account username used by the connector to register itself.
# Typically service@<tenant-subdomain>.<root-domain>.
SIA_USERNAME=""

# -----------------------------------------------------------------------------
# REQUIRED — your own infrastructure
# -----------------------------------------------------------------------------

# The container registry you will publish the connector image to. The image is
# built locally and pushed here, because ROOT_DOMAIN is compiled into it.
# Examples:
#   REGISTRY="123456789012.dkr.ecr.eu-west-1.amazonaws.com"
#   REGISTRY="harbor.example.com/sia"
#   REGISTRY="myorg"                       # Docker Hub namespace
REGISTRY=""

# Credentials for that registry. Omit both for Amazon ECR (the installer uses
# the AWS CLI) or if this machine is already logged in via `docker login`.
#REGISTRY_USERNAME=""
#REGISTRY_PASSWORD_FILE="./registry-token"

# -----------------------------------------------------------------------------
# OPTIONAL — defaults shown; uncomment only to change
# -----------------------------------------------------------------------------

#NAMESPACE="sia-k8s-connector"
#RELEASE="sia-connector"
#REPLICAS="1"
#IMAGE_NAME="cms-k8s-connector"
#IMAGE_TAG="latest"
#PULL_SECRET="sia-registry-creds"

# Where to get the Helm chart. Either a Helm repository URL or a local .tgz.
# Leave unset to use the published CyberArk chart repository.
#CHART_REF="./sia-connector-1.0.19.tgz"

# Pin a chart version. Unset means "newest available".
#CHART_VERSION=""

# Storage class for the connector's 1Gi volume. Leave unset to use the cluster
# default. REQUIRED if your cluster has no default class — notably Amazon EKS
# Auto Mode, where you want:
#STORAGE_CLASS="gp3-auto"

# Outbound HTTP/HTTPS proxy, if your cluster nodes require one to reach the
# internet. Applied to every outbound call the connector makes.
#PROXY_URL="http://proxy.example.com:3128"

# Name reported to SIA alongside the pod name, as <CLUSTER_NAME>\<pod>.
# Left unset, the connector auto-detects EKS, GKE and AKS cluster names and
# falls back to the literal "k8s" elsewhere. Set it explicitly if you run
# several clusters against one pool, so you can tell them apart in the portal.
#CLUSTER_NAME="production-eu"

# Image build settings. Change --platform only if your nodes are not x86_64
# (check with: kubectl get nodes -o wide).
#PLATFORM="linux/amd64"
#KUBECTL_VERSION="v1.30.0"

# The image's base layer. alpine:latest is fine for evaluation; use a hardened,
# scanned base image for production.
#BASE_IMAGE="alpine:latest"

# Directory containing the connector Dockerfile. Auto-detected if you run the
# installer from the chart repository.
#DOCKERFILE_DIR="./sia-k8s-connector/docker"

# -----------------------------------------------------------------------------
# THE PASSWORD — deliberately not settable here
# -----------------------------------------------------------------------------
# The installer will not read a password from this file, because config files
# get committed, copied and shared by accident. Supply it one of these ways:
#
#   1. Interactive prompt (recommended) — just run the installer; it asks, and
#      the input is masked.
#
#   2. A file readable only by you:
#        umask 077 && printf '%s' 'the-password' > ./sia-password
#        ./sia-connector-install.sh --config ./sia-connector.env \
#          --password-file ./sia-password
#        shred -u ./sia-password    # or rm
#
#   3. An environment variable, for CI:
#        SIA_PASSWORD="$(get-from-your-vault)" ./sia-connector-install.sh ... --yes
#
# There is no --password flag: it would be visible to every user on the machine
# via `ps`, and would persist in your shell history.

# =============================================================================
# CyberArk SIA Kubernetes Connector — parameters
#
#   cp scripts/sia-connector.env.example sia-connector.env
#   $EDITOR sia-connector.env
#   chmod 600 sia-connector.env
#   ./scripts/sia-connector-prerequisites.sh --config ./sia-connector.env --check-only
#   ./scripts/sia-connector-prerequisites.sh --config ./sia-connector.env
#
# One file serves every step. RELEASE and CLUSTER_NAME apply only to the Helm
# release itself and are marked as such; everything else below is used to
# validate, build, publish, or create the secrets.
#
# Every value below can also be passed as a command-line flag; flags win.
# Do NOT put the service-account password in this file — see the note at the end.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — from the SIA Admin Portal
# -----------------------------------------------------------------------------

# The domain of your SIA environment. Used to build the identity and API URLs:
#   https://<IDAPTIVE_TENANT_ID>.id.<ROOT_DOMAIN>
#   https://<TENANT_SUBDOMAIN>.dpa.<ROOT_DOMAIN>/api
# This value is compiled into the container image and cannot be changed
# afterwards without rebuilding.
ROOT_DOMAIN="cyberark.cloud"

# Your CyberArk Identity tenant ID (Identity Administration → Settings).
IDAPTIVE_TENANT_ID=""

# Your tenant subdomain — the first label of your SIA portal URL.
TENANT_SUBDOMAIN=""

# -----------------------------------------------------------------------------
# REQUIRED — your own infrastructure
# -----------------------------------------------------------------------------

# The container registry you will publish the connector image to. The image is
# built locally and pushed here, because ROOT_DOMAIN is compiled into it.
# Examples:
#   REGISTRY="123456789012.dkr.ecr.eu-west-1.amazonaws.com"
#   REGISTRY="harbor.example.com/sia"
#   REGISTRY="myorg"                       # Docker Hub namespace
REGISTRY=""

# Credentials for that registry. Omit both for Amazon ECR (the AWS CLI is used
# instead) or if this machine is already logged in via `docker login`.
#REGISTRY_USERNAME=""
#REGISTRY_PASSWORD_FILE="./registry-token"

# The image's base layer.
BASE_IMAGE=""

# -----------------------------------------------------------------------------
# OPTIONAL — defaults shown; uncomment only to change
# -----------------------------------------------------------------------------

#NAMESPACE="sia-k8s-connector"
#RELEASE="sia-connector"              # helm release only
#IMAGE_NAME="cms-k8s-connector"
#IMAGE_TAG="latest"
#PULL_SECRET="sia-registry-creds"

# Image build settings. PLATFORM is checked against your nodes' architecture by
# the prerequisite checks; change it only if your nodes are not x86_64 (check
# with: kubectl get nodes -o wide).
#PLATFORM="linux/amd64"
#KUBECTL_VERSION="v1.30.0"

# Directory containing the connector Dockerfile. Auto-detected if you run the
# scripts from the chart repository.
#DOCKERFILE_DIR="../sia-k8s-connector/docker"
